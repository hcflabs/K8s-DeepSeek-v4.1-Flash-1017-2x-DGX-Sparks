# shellcheck shell=bash
# shellcheck disable=SC2034 # sourced by scripts/image-tag.sh, scripts/build-image.sh and CI
# The engine image's pins: upstream scripts/config.sh at the commit in SYNC.md. The
# image tag is <TAG_BASE>-<hash of zig/patches, zig/patches-inputs, zig/Dockerfile
# and the pins below> (scripts/image-tag.sh), the same hash upstream writes into
# the image's tf.patches label. chart/values.yaml image.tag must equal it; CI
# checks that.
TF_REPO=https://github.com/bertholomus/TensorFold.git
TF_REF=fbbc97132cd004237d9887b8d3185896efaedc5c
INPUTS_REF=59402086381a42c74d53053443224eec2790b4c5
ZIG_VERSION=0.17.0
ZIG_SHA256=9e8d11661d4ae3bd57702a3832781e23ad151dde5798e16a5ccd503f65234ff8
# Not part of the hash (the compiler's bytes are pinned by ZIG_SHA256).
ZIG_MIRRORS="https://zig.linus.dev/zig"
BASE_IMAGE=nvcr.io/nvidia/pytorch:26.07-py3
TAG_BASE=exl3-tp2
IMAGE_REPOSITORY=ghcr.io/hcflabs/dsv41-flash-1017-tensorfold
